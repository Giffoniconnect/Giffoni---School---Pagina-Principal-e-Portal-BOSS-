rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Master Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function getProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(role) { return isSignedIn() && getProfile().role == role; }
    function isBoss() { return isSignedIn() && getProfile().role.matches('^BOSS_.*') || getProfile().role == 'SUPER_BOSS'; }
    function isAdmin() { return isSignedIn() && (getProfile().role == 'SUPER_BOSS' || getProfile().role == 'BOSS_ADMIN'); }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 2. Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isBoss());
      allow list: if isAdmin();
      
      function isValidUser(data) {
        return data.uid == request.auth.uid 
          && data.email is string 
          && data.role in ['ALUNO', 'PROFESSOR'] // Users can't self-assign BOSS roles
          && data.keys().hasAll(['uid', 'email', 'role'])
          && data.keys().size() <= 10;
      }

      allow create: if isVerified() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId 
        && incoming().role == existing().role // Role is immutable for the user
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    // 3. Home Sections
    match /home_sections/{sectionId} {
      allow read: if (existing().isActive == true) || isBoss();
      allow write: if isBoss() && isValidId(sectionId);
      
      function isValidSection(data) {
        return data.type is string && data.order is number && data.isActive is bool
          && data.title is string && data.title.size() < 200;
      }
      
      allow create: if isBoss() && isValidSection(incoming());
      allow update: if isBoss() && isValidSection(incoming());
    }

    // 4. Courses
    match /courses/{courseId} {
      allow get: if (existing().status == 'published') || isBoss();
      allow list: if (resource.data.status == 'published') || isBoss();
      
      function isValidCourse(data) {
        return data.title is string && data.slug is string && data.price is number
          && data.status in ['draft', 'published', 'archived'];
      }

      allow write: if isAdmin() && isValidId(courseId) && isValidCourse(incoming());
    }

    // 5. Enrollments
    match /enrollments/{enrollmentId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isBoss());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBoss());
      
      allow create: if isAdmin(); // Only system/admin can create enrollments for now (via server/stripe)
    }
  }
}
